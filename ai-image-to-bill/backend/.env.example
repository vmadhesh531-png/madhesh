# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Application Settings
APP_NAME=AI Image-to-Bill
APP_VERSION=1.0.0
DEBUG=false
MAX_UPLOAD_SIZE=20971520
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Logging
LOG_LEVEL=INFO
